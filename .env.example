# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_if_supabase_shows_it
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
# IMPORTANT: STRIPE_SECRET_KEY must start with sk_test_ or sk_live_
STRIPE_SECRET_KEY=
# Local testing: get this from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Email provider for absence/contact/member notices/bulk email
# Option A: Brevo Free SMTP / any SMTP provider
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CLUB_FROM_EMAIL=
CLUB_FROM_NAME=Howick-Pakuranga Chess Club
CLUB_REPLY_TO_EMAIL=

# Option B: Resend instead of SMTP - leave SMTP blank and set EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Membership fees in cents
NEXT_PUBLIC_SCHOOL_PUPIL_FEE_CENTS=7500
NEXT_PUBLIC_SCHOOL_PUPIL_TERM3_FEE_CENTS=5000
NEXT_PUBLIC_INDIVIDUAL_FEE_CENTS=12000
NEXT_PUBLIC_INDIVIDUAL_AFTER_JULY_FEE_CENTS=9000
NEXT_PUBLIC_ASSOCIATE_FEE_CENTS=6000

# Address autocomplete provider
ADDRESS_PROVIDER=manual
ADDY_API_KEY=
# Optional override if your Addy account uses a different endpoint
ADDY_API_URL=

# NZ Post AddressChecker: request API access in the NZ Post developer portal.
# Set ADDRESS_PROVIDER=nzpost to activate; credentials must never use NEXT_PUBLIC_.
NZPOST_CLIENT_ID=
NZPOST_CLIENT_SECRET=

# Scheduled Stripe reminders. Private secret; disabled until explicitly configured.
CRON_SECRET=
ENABLE_PAYMENT_REMINDERS=false
